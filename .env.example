# 搭手 Dashou env-driven 部署示例。
# 交互式使用只需 `dashou init` + `dashou serve`，不需要这些变量。
# 以下变量仅在完全非交互 / 环境变量驱动部署时使用。

HOST=127.0.0.1
PORT=7677

# 必填（非交互模式）：由 `dashou init` 自动生成并写入 ~/.dashou/auth.json。
# DASHOU_OAUTH_OWNER_TOKEN=change-me-to-a-long-random-secret-at-least-16-chars
# DASHOU_ALLOWED_ROOTS=~/projects/personal,~/projects/work

# ChatGPT 访问的公网 HTTPS 地址（不带 /mcp）。Tunnel 由你自己维护时必填。
# DASHOU_PUBLIC_BASE_URL=https://your-name.warmbyte.studio

# 内测管理员分配的 Cloudflare Tunnel Token。配置后 `dashou serve` 会自动启动 cloudflared。
# DASHOU_TUNNEL_TOKEN=

# Optional OAuth tuning.
# DASHOU_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# DASHOU_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# DASHOU_OAUTH_SCOPES=dashou
# DASHOU_OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,localhost,127.0.0.1

# 受控内测本机策略（可选）。这不是远程账号/计费系统。
# DASHOU_PILOT_ENABLED=1
# DASHOU_PILOT_ACCOUNT_ID=pilot-alice
# DASHOU_PILOT_EXPIRES_AT=2026-09-01T00:00:00.000Z
# Optional remote control-plane policy. The endpoint returns a signed short-lived lease:
# { "lease": "<base64url-payload>.<base64url-rsa-pss-signature>" }
# The token is sent as Authorization: Bearer and is never logged. The endpoint returns a signed short-lived lease.
# DASHOU_PILOT_POLICY_URL=https://control.example/pilot-policy
# DASHOU_PILOT_POLICY_TOKEN=
# DASHOU_PILOT_POLICY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# DASHOU_PILOT_POLICY_CACHE_TTL_SECONDS=300

# 最小内测控制面（单独运行 `dashou pilot-control`，管理员 token 只通过环境注入）。
# DASHOU_PILOT_CONTROL_HOST=127.0.0.1
# DASHOU_PILOT_CONTROL_PORT=8787
# DASHOU_PILOT_CONTROL_ADMIN_TOKEN=change-me-to-a-long-random-secret
# DASHOU_PILOT_CONTROL_LEASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# DASHOU_PILOT_CONTROL_LEASE_TTL_SECONDS=900
# DASHOU_PILOT_CONTROL_STATE_DIR=~/.local/share/dashou-control
# 平台 Worker 已部署时：
# DASHOU_PILOT_CONTROL_URL=https://dashou-pilot-control.whilewon.workers.dev
# DASHOU_PILOT_CONTROL_ADMIN_TOKEN=只在管理员终端临时注入

# 可选：OpenAI Responses API 的真实 remote-MCP smoke（不会冒充 ChatGPT UI 证据）。
# OPENAI_API_KEY=
# DASHOU_MCP_URL=https://your-name.warmbyte.studio/mcp
# DASHOU_MCP_OWNER_TOKEN=
# DASHOU_OPENAI_PROJECT_PATH=/absolute/path/to/a-disposable-pilot-project
# DASHOU_OPENAI_READ_PATH=notes.txt
# DASHOU_OPENAI_WRITE_PATH=.dashou-openai-smoke.txt
# OPENAI_MODEL=gpt-5.6
# OPENAI_MCP_AUTO_APPROVE_MUTATIONS=1

# 进阶
# DASHOU_ALLOWED_HOSTS=localhost,127.0.0.1,your-public-host.example.com
# DASHOU_TRUST_PROXY=1
# DASHOU_STATE_DIR=~/.local/share/dashou
# DASHOU_CONFIG_DIR=~/.dashou
# DASHOU_UPDATE_MANIFEST_URL=https://github.com/winston003/dashou-releases/releases/latest/download/cli-latest.json
