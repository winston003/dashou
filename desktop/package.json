{
  "name": "@warmbyte/dashou-desktop",
  "private": true,
  "version": "0.1.3-rc.11",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:frontend": "vite build",
    "test:structure": "node scripts/verify-ui-structure.mjs",
    "test:ui": "tsx --test tests/*.test.ts",
    "prepare:resources": "node scripts/prepare-resource-dirs.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:ui-budget": "node scripts/verify-ui-budget.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run release:check && npm run clean:updater-artifacts && tauri build",
    "release:check": "node scripts/check-release-config.mjs",
    "clean:updater-artifacts": "node scripts/clean-updater-artifacts.mjs",
    "release:manifest": "node scripts/create-updater-manifest.mjs",
    "content:package": "npm run build:frontend && node scripts/create-content-release.mjs",
    "stage": "node scripts/stage-runtime.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.9.1",
    "fflate": "^0.8.2",
    "vite": "^7.1.2"
  }
}
