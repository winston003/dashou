{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dashou",
  "version": "0.1.3-rc.14",
  "identifier": "studio.warmbyte.dashou",
  "build": {
    "frontendDist": "../dist-ui",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:frontend && npm run stage && npm run verify:runtime",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "搭手 Dashou",
        "width": 800,
        "height": 520,
        "minWidth": 680,
        "minHeight": 460,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../vendor/node-runtime",
      "../vendor/dashou-runtime",
      "../vendor/cloudflared"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDQjBFOTkwNUI2N0Q0RTQKUldUazFHZGJrT213TEtMUUtLdDF3NVkxSngwRVFJdEM3elBOOUlkb1lyVnhXWFNwbEIybk4vOHYK",
      "endpoints": [
        "https://github.com/winston003/dashou-releases/releases/download/pilot-current/latest.json",
        "https://github.com/winston003/dashou-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
