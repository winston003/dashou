{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dashou",
  "version": "0.1.3-rc.1",
  "identifier": "studio.warmbyte.dashou",
  "build": {
    "frontendDist": "../dist-ui",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:frontend && npm run stage",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "搭手 Dashou",
        "width": 560,
        "height": 670,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../vendor/node-runtime",
      "../vendor/dashou-runtime",
      "../vendor/cloudflared"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDQjBFOTkwNUI2N0Q0RTQKUldUazFHZGJrT213TEtMUUtLdDF3NVkxSngwRVFJdEM3elBOOUlkb1lyVnhXWFNwbEIybk4vOHYK",
      "endpoints": [
        "https://github.com/winston003/dashou-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
